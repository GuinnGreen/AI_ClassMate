rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 公告系統：已登入使用者可讀；寫入僅限後端
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Keep existing owner reads, including historical logs and the user document.
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // The first collection boundary excludes logs AND all its descendants.
    // Admin SDK is the only writer of quota/audit logs. Top-level aiQuotaCounters
    // stays denied by default for all clients (including its owner).
    match /users/{userId}/{collectionName}/{document=**} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && collectionName != 'logs';
    }

    // 預設拒絕所有未明確允許的存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
