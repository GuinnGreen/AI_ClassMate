{
  "name": "classmate-ai---智慧班級經營系統",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "emulators": "firebase emulators:start --project demo-classmate-ai --only auth,firestore,functions",
    "test:rules:run": "vitest run --config vitest.rules.config.ts",
    "test:rules": "firebase emulators:exec --project demo-classmate-ai --only firestore \"npm run test:rules:run\"",
    "release:manifest": "tsx scripts/generate-release-manifest.mjs",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "firebase": "^12.9.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.564.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.28.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
